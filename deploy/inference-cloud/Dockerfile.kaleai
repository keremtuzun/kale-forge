# The recovered "Kale.ai — Hardware Engineering AI" app, rebuilt for the new box.
#
# Derived from the VM's own Dockerfile (recovered from the boot-volume clone), with one
# deliberate change: the original baked in llama-cpp-python plus a 1.5B GGUF and ran its own
# in-container inference. Here that is dropped entirely and the app is pointed at the v18
# service running beside it — so the whole product answers with v18 instead of the old 1.5B,
# and the image builds in minutes on ARM instead of compiling llama.cpp from source.
FROM node:22-bookworm-slim AS web-builder

WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
RUN npm ci

COPY apps/web apps/web
COPY packages/shared-types packages/shared-types
ENV NEXT_PUBLIC_USE_SAME_ORIGIN=true \
    ANALYSIS_INTERNAL_URL=http://127.0.0.1:8000
RUN npm run build:web

FROM node:22-bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip

WORKDIR /app
COPY services/analysis /app/services/analysis
RUN /opt/venv/bin/pip install --no-cache-dir /app/services/analysis

COPY --from=web-builder /app/package.json /app/package.json
COPY --from=web-builder /app/package-lock.json /app/package-lock.json
COPY --from=web-builder /app/node_modules /app/node_modules
COPY --from=web-builder /app/apps/web /app/apps/web
COPY --from=web-builder /app/packages/shared-types /app/packages/shared-types

# Start script: analysis API then Next.js. No in-container inference — INFERENCE_URL points
# at the v18 service, so a failure there degrades the same way the studio does.
COPY start-kaleai.sh /app/start-kaleai.sh
RUN chmod +x /app/start-kaleai.sh

ENV PORT=7860 \
    NEXT_PUBLIC_USE_SAME_ORIGIN=true \
    ANALYSIS_INTERNAL_URL=http://127.0.0.1:8000 \
    DATABASE_URL=sqlite:////data/kale/kale.db \
    STORAGE_BACKEND=local \
    STORAGE_LOCAL_DIR=/data/kale/storage \
    LOG_DIR=/data/kale/logs

EXPOSE 7860 8000
CMD ["/app/start-kaleai.sh"]
