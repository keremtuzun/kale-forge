# Copy to .env on the VM (push-from-laptop.ps1 writes it for you).
# The public hostname Caddy answers on. nip.io resolves it to the VM with zero DNS setup:
# for a VM at 203.0.113.7 use  kale-infer.203.0.113.7.nip.io
KALE_HOST=kale-infer.YOUR_VM_IP.nip.io
# Shared secret between Vercel and this box. Everything except /health requires it.
KALE_API_TOKEN=CHANGE_ME
# Model serving (defaults match the laptop supervisor).
KALE_MODEL_VERSION=kale-design-qwen3-4b-v18-cad-repair-50
KALE_LLAMA_THREADS=4
KALE_LLAMA_CTX=8192
