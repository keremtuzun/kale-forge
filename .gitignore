# Node
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Env & secrets
.env
.env.local
.env.*.local

# Data & models (tracked via DVC / object storage, not git)
storage/
*.db
*.sqlite
# SQLite write-ahead log and shared-memory files are live runtime state, not source.
*.db-wal
*.db-shm
models/checkpoints/*
models/adapters/*
!models/checkpoints/.gitkeep
!models/adapters/.gitkeep
datasets/raw/*
!datasets/raw/.gitkeep
# Processed corpora are regenerated from the runtime modules by
# kale_training.generate_frc_corpus and verified byte-identical by their manifest sha256,
# so the generator and its seed are the source of truth, not 76 MB of checked-in jsonl.
# The manifest is kept: it carries the seed, row counts and split sha256s that make a
# corpus reproducible. Git cannot re-include a file inside an excluded directory, so the
# directories themselves have to stay walkable.
datasets/processed/**
!datasets/processed/**/
!datasets/processed/*/manifest.json
mlruns/
wandb/

# OS / editor
.DS_Store
.idea/
.vscode/
# In-progress training checkpoints. The -work suffix keeps a partially trained adapter
# durable across sessions without committing 11 MB every 100 iterations; the finished
# adapter is promoted to models/adapters/<name>/ by scripts/finish-design-adapter.sh.
models/adapters/*-work/

# Scratch workspace: the MLX training venv, a vendored vercel CLI, deploy tarballs and
# throwaway geometry. Tooling and outputs, not source — and the venv in particular should be
# reinstalled onto local disk rather than read from here (see docs/training-guide.md).
work/
kale-v18-lightning.zip
models/evaluations/*.progress.json

# Training and eval run logs: run output, not source. The durable artifacts of a run are
# its checkpoints (models/adapters/) and its scorecard (models/evaluations/).
logs/

# Vercel project links and absorbed nested-repo histories
.vercel/

# Trained weights. An adapter is a build output of a run, not source: the recipe
# (training/configs/, services/training/) and the scorecard (models/evaluations/) are what
# reproduce it. A 126 MB safetensors is also over GitHub's hard 100 MB per-file limit.
models/adapters/**/*.safetensors
models/adapters/**/tokenizer.json

# Oracle recovery payload: the pulled /opt/kale tree and its tarballs are a BACKUP of a
# running box. The scripts that produced them are tracked; the 115 MB payload is not.
deploy/oracle-recovery/recovered/
*.tar.gz

# Render output from dev_server.py's /capture receiver.
apps/site/captures/
