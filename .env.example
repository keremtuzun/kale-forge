# ── Kale.ai environment ──────────────────────────────────────────────────────
# Copy to .env and adjust. Never commit real secrets.

# Web app
NEXT_PUBLIC_ANALYSIS_API_URL=http://localhost:8000
AUTH_DISABLED=true                 # true = local dev without login; NEVER true in production
AUTH_SECRET=change-me              # Auth.js secret (required when AUTH_DISABLED=false)
# Required when AUTH_DISABLED=false: first API user, authenticated with
# Authorization: Bearer $BOOTSTRAP_API_TOKEN. Leave blank in local demo mode.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_API_TOKEN=
PUBLIC_WEB_URL=http://localhost:3000
PASSWORD_RESET_MINUTES=30

# Transactional account email. Oracle Email Delivery, Brevo, Postmark, and
# other standard SMTP services work here. Keep credentials in the server
# environment only; never expose them through NEXT_PUBLIC_* variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Kale AI
SMTP_STARTTLS=true

# Analysis service
DATABASE_URL=sqlite:///./kale.db   # production: postgresql+psycopg://user:pass@host:5432/kale
STORAGE_BACKEND=local              # local | s3
STORAGE_LOCAL_DIR=./storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
S3_BUCKET=
S3_ENDPOINT_URL=                   # any S3-compatible endpoint (MinIO, R2, …)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
JOB_BACKEND=inprocess              # inprocess | redis
REDIS_URL=redis://localhost:6379/0
MAX_UPLOAD_MB=50
ADMIN_TOKEN=change-me-admin        # required for /models/select and /training/* endpoints

# Inference service (self-hosted only — no external AI APIs exist in this system)
INFERENCE_URL=http://localhost:8001
INFERENCE_TIMEOUT_SECONDS=30       # increase for CPU-only hosted inference
KALE_INFERENCE_PROVIDER=stub       # stub | local_llamacpp | local_transformers | local_vllm | local_mlx
KALE_MODEL_PATH=                   # gguf path (llamacpp) or HF id, e.g. mlx-community/Qwen3-4B-Instruct-2507-4bit (mlx)
KALE_ADAPTER_PATH=                 # optional LoRA adapter directory, e.g. models/adapters/kale-design-qwen3-4b-v16
# To serve the selected design adapter (v18) set all three together — it is a PEFT LoRA, not
# an MLX one, so local_mlx will not load it.  Needs `pip install -e "services/analysis[transformers]"`;
# without lm-format-enforcer the provider refuses to sample and designs fall back to the
# deterministic path.  See models/MODEL_CARD_DESIGN_V18.md.
#   KALE_INFERENCE_PROVIDER=local_transformers
#   KALE_MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507
#   KALE_ADAPTER_PATH=models/adapters/kale-design-qwen3-4b-v18-cad-repair-50
KALE_VLLM_URL=http://localhost:8010/v1   # Kale-controlled vLLM server (production)
KALE_MODEL_VERSION=dev
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5  # local sentence-transformers; hash-fallback used if unavailable
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Training / tracking (all local)
MLFLOW_TRACKING_URI=file:./mlruns
WANDB_MODE=disabled
