{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/studio.py": {
      "maxDuration": 300
    },
    "api/oracle.py": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/models",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/models/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/design",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/design/:path*",
      "destination": "/studio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/api/studio"
    },
    {
      "source": "/api/studio/:path*",
      "destination": "/api/studio"
    },
    {
      "source": "/api/:path*",
      "destination": "https://kaleai-app.150.136.212.31.nip.io/api/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://kaleai-app.150.136.212.31.nip.io/_next/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://kaleai-app.150.136.212.31.nip.io/brand/:path*"
    },
    {
      "source": "/login",
      "destination": "/api/oracle?path=/login"
    },
    {
      "source": "/signup",
      "destination": "/api/oracle?path=/signup"
    },
    {
      "source": "/forgot-password",
      "destination": "/api/oracle?path=/forgot-password"
    },
    {
      "source": "/reset-password",
      "destination": "/api/oracle?path=/reset-password"
    },
    {
      "source": "/account",
      "destination": "/api/oracle?path=/account"
    },
    {
      "source": "/app",
      "destination": "/api/oracle?path=/app"
    },
    {
      "source": "/projects/:path*",
      "destination": "/api/oracle?path=/projects/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/auth/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-qvco1qQD3gdZCArBdVxHbdfJmxvQM1op23/69iINVY0='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}