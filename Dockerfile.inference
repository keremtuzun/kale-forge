FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

# The analysis package supplies the shared FastAPI/Pydantic/HTTP dependencies.
COPY services/analysis /tmp/analysis
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir /tmp/analysis
COPY services/inference /app/services/inference

WORKDIR /app/services/inference
EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
